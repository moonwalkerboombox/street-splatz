# Copy to .env (or set these in the Cloudflare build settings).

# Which network the site talks to. One of base, baseSepolia, anvil. Default base.
VITE_CHAIN=base

# The deployed SplatzMachine address. Leave empty to run the site in preview mode
# (everything renders, no wallet prompts, the coin says The Machine opens soon).
VITE_CONTRACT_ADDRESS=

# Optional. Your own RPC endpoint. It is tried first and the public one stays as backup.
VITE_RPC_URL=

# Optional. The price in ETH that is about 50 US cents. Default 0.0003.
# The page says "about 50 cents" only while the price on chain equals this. At any other price it shows
# the ETH price alone. Change it together with the price, or leave it and the note simply goes away.
VITE_FIFTY_CENT_PRICE_ETH=

# Optional. The public site address with no trailing slash, used for the share image link.
# "npm run build" at the repo root uses SITE_URL for this, so most setups can leave it empty.
VITE_SITE_URL=
