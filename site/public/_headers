# Cloudflare response headers for the static site. Cloudflare reads this file from site/dist.
# When two rules match one address, Cloudflare joins the values of a repeated header, so no
# address below gets Cache-Control from more than one rule.
# Pages (/, /admin, the 404 page) keep Cloudflare's default: always check for a new version.

# Token and collection metadata. Marketplaces fetch these from other sites.
# No Content-Type here on purpose: Cloudflare already serves .json files as JSON, and a forced type
# would also label the HTML "not found" page as JSON when someone asks for a card that does not exist.
/meta/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  X-Content-Type-Options: nosniff

# Card art. Marketplaces and wallets fetch these from other sites.
/img/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400
  X-Content-Type-Options: nosniff

# The card list the page reads.
/cards.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=300
  X-Content-Type-Options: nosniff

# Script and style files. The build puts a fingerprint in each file name, so they can be kept for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

/
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin

# The owner page. Keep it out of search engines.
/admin
  X-Robots-Tag: noindex, nofollow
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
